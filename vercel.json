{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/call/:room",
      "destination": "/call/index"
    },
    {
      "source": "/trabalhos/:slug",
      "destination": "/api/site?pagina=projeto&slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/site?pagina=blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/site?pagina=post&slug=:slug"
    },
    {
      "source": "/midia/:arquivo",
      "destination": "/api/site?midia=:arquivo"
    },
    {
      "source": "/sitemap-conteudos.xml",
      "destination": "/api/site?sitemap=1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.fihan.com.br"
        }
      ],
      "destination": "https://fihan.com.br/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.fihan.com.br"
        }
      ],
      "destination": "https://fihan.com.br/:path",
      "permanent": true
    }
  ]
}
